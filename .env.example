# Copy to .env on the remote server. Never commit the populated file.
COMPOSE_PROJECT_NAME=project-collaboration
PUBLIC_DOMAIN=project.example.com
PUBLIC_SCHEME=https
TLS_EMAIL=admin@example.com
SESSION_COOKIE_SECURE=true

# Published ports
HTTP_PORT=80
HTTPS_PORT=443

# Images (pin immutable versions or digests in production)
WEB_IMAGE=project-collaboration-web:0.1.0
CORE_IMAGE=project-collaboration-core:0.1.0
AGENT_IMAGE=project-collaboration-agent:0.1.0
INDEXER_IMAGE=project-collaboration-indexer:0.1.0
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
ELASTICSEARCH_IMAGE=elasticsearch:9.4.4
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
CADDY_IMAGE=caddy:2-alpine

# Python package source used only while building Agent and Indexer images.
PYPI_INDEX_URL=https://pypi.org/simple

# PostgreSQL bootstrap
POSTGRES_DB=project_collaboration
POSTGRES_USER=project_collaboration
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Redis bootstrap
REDIS_PASSWORD=replace-with-a-long-random-password

# MinIO bootstrap
MINIO_ROOT_USER=project-collaboration-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_BUCKET=project-files

# Elasticsearch bootstrap
ELASTIC_PASSWORD=replace-with-a-long-random-password
ES_JAVA_OPTS=-Xms8g -Xmx8g

# Application bootstrap. Generate 32 random bytes and Base64-encode them.
APP_CONFIG_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
APP_BOOTSTRAP_ADMIN_GITHUB_LOGIN=replace-with-your-github-login
# GitHub OAuth is a platform bootstrap dependency. Project GitHub Apps and
# repository tokens are configured later through the UI.
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Model connection used by Agent Service. Project-specific model endpoints or
# credentials can be added later through the protected resource UI.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=replace-with-model-api-key
MODEL_NAME=replace-with-model-name
EMBEDDING_MODEL=replace-with-embedding-model-name

# Service-to-service credentials
CORE_AGENT_TOKEN=replace-with-a-long-random-service-token
CORE_INDEXER_TOKEN=replace-with-a-long-random-service-token

# Runtime settings
APP_LOG_LEVEL=INFO
APP_TIME_ZONE=Asia/Shanghai
UPLOAD_MAX_BYTES=104857600
AGENT_MAX_CONTEXT_TOKENS=30000
INDEXER_WORKERS=2
